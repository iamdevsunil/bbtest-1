# Deployer wallet private key (FROM MetaMask)
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Etherscan v2 unified API key (works for BscScan too)
# Get yours at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional: custom RPC
BSC_RPC_URL=https://bsc-dataseed.binance.org
